{
    "name":  "maa-associates-asycuda-app",
    "version":  "1.0.0",
    "description":  "MAA ASSOCIATES ASYCUDA desktop application",
    "main":  "electron-main.js",
    "private":  true,
    "scripts":  {
                    "start":  "node server.js",
                    "desktop":  "electron .",
                    "build:win":  "electron-builder --win --x64"
                },
    "build":  {
                  "appId":  "com.maaassociates.asycuda",
                  "productName":  "MAA ASSOCIATES ASYCUDA",
                  "directories":  {
                                      "output":  "desktop-dist-fixed"
                                  },
                  "files":  [
                                "electron-main.js",
                                "server.js",
                                "index.html",
                                "style.css",
                                "script.js",
                                "note_sheet.html",
                                "note_sheet_style.css",
                                "README.txt",
                                "WEB_APP_README.txt",
                                "fonts/**/*",
                                "data/**/*"
                            ],
                  "win":  {
                              "target":  "nsis",
                              "signAndEditExecutable":  false
                          }
              },
    "devDependencies":  {
                            "electron":  "latest",
                            "electron-builder":  "latest"
                        }
}
